# Mayhem target: py-persian-tools Persian-language utility library (Atheris/libFuzzer harness).
# Target name `persian_tools_fuzz` is preserved from the original fork integration so the
# historical Mayhem run history stays attached. The cmd binary is the compiled ELF launcher
# that drives mayhem/fuzz_persian_tools.py; Atheris instruments the persian_tools package so
# the run records coverage (edges).
project: py-persian-tools
target: persian_tools_fuzz

cmds:
  - cmd: /mayhem/persian_tools_fuzz
    libfuzzer: true
